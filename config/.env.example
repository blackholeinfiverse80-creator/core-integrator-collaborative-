# Core Integrator Configuration

# API Configuration
VERCEL_ENV=production
VERCEL_REGION=auto

# LLM Integration
GROQ_API_KEY=your_groq_api_key_here

# Service URLs
# Note: Vercel env vars do not expand other env vars in values.
# Set these to your actual deployed domain (for example: https://your-app.vercel.app/api/...)
PROMPT_RUNNER_URL=https://your-app.vercel.app/api/prompt-runner
CREATOR_CORE_URL=https://your-app.vercel.app/api/creator-core
BHIV_CORE_URL=https://your-app.vercel.app/api/bhiv-core
BUCKET_URL=https://your-app.vercel.app/api/bucket
INTEGRATION_BRIDGE_URL=https://your-app.vercel.app/api/integration-bridge

# Database Configuration (MongoDB Atlas)
USE_MONGODB=true
MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/bhiv_production?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=bhiv_production

# Storage Configuration (AWS S3)
USE_EXTERNAL_STORAGE=true
AWS_S3_BUCKET=your-bhiv-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Feature Flags
ENABLE_BHIV_FORWARD=true
ENABLE_REMOTE_EXECUTION=true
ENABLE_TELEMETRY=true

# Logging
LOG_LEVEL=INFO

# Legacy/local options (optional)
DB_PATH=db/context.db
NOOPUR_BASE_URL=http://localhost:5001
INTEGRATOR_USE_NOOPUR=false
NOOPUR_API_KEY=

# Security (SSPL Phase III)
SSPL_ENABLED=false
SSPL_ALLOW_DRIFT_SECONDS=300
